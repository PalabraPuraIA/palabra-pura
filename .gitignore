# Secrets / local env
.env
.env.*
!.env.example

# Llaves SSH: nunca subir claves privadas al repo
id_ed25519*
id_rsa*
*.pem
*.key

# Huge DB dump (GitHub max file ~100MB). Keep schema only in git.
db/data.sql

# Supabase CLI local linkage (may contain connection hints)
supabase/.temp/
supabase/.branches/
supabase/.temp/**

# Edge function compiled bundles (binary); keep extracted index.ts
supabase/functions/**/*.bundle

# Nested clone metadata
web/app/.git/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
__pycache__/
node_modules/

# Runtime / logs
*.log
web/server/data/
stack/runtime/
!stack/runtime/.gitkeep
# Local machine overrides (private bind IPs, etc.) — do not publish
stack/docker-compose.override.yml
