    {
      "parameters": {
        "jsCode": "// Recuperamos los datos originales del lote actual\nconst lotesOriginales = $items(\"Get Pending Chunks\");\n\n// Extraemos el array de embeddings de la respuesta de Google (corregido con .first())\nconst batchResponse = $input.first().json.embeddings;\n\nconst resultados = [];\n\n// Emparejamos cada vector con su ID original\nfor (let i = 0; i < batchResponse.length; i++) {\n  resultados.push({\n    json: {\n      // IMPORTANTE: Cambia 'id' por el nombre de tu columna ID si es diferente\n      id: lotesOriginales[i].json.id, \n      embedding_vector: batchResponse[i].values\n    }\n  });\n}\n\n// Esto devuelve N elementos individuales perfectos para Supabase\nreturn resultados;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        64
      ],
      "id": "32d7fc1d-7751-4e80-9d4a-14758a68765c",
      "name": "Processing Embedding"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Mapeamos los textos al formato de la API\nconst requests = items.map(item => ({\n  model: \"models/embedding-001\",\n  content: {\n    // IMPORTANTE: Cambia 'text_chunk' por el nombre exacto de la columna de tu texto en la BD\n    parts: [{ text: item.json.chunk_text }] \n  }\n}));\n\n// Retornamos 1 solo elemento agrupado\nreturn [{\n  json: {\n    requests: requests\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        160
      ],
      "id": "4a25e3c6-f454-4da1-96e8-9329b12508ed",
      "name": "Embedding Requests"
    },
    {
      "parameters": {
        "jsCode": "// Generamos un array de 10 elementos (representan 10 lotes de 100 = 1,000 versículos)\nconst totalLotes = 20; \nconst lotes = [];\n\nfor (let i = 1; i <= totalLotes; i++) {\n  lotes.push({ json: { numero_lote: i } });\n}\n\nreturn lotes;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        240
      ],
