FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg python3 python3-pip ca-certificates \
 && pip3 install --break-system-packages yt-dlp \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY stack/scripts/package.json ./
RUN npm install --omit=dev
COPY stack/scripts/transcribe-videos.mjs stack/scripts/reindex-fragment-embeddings.mjs stack/scripts/audit-retrieval.mjs ./

ENTRYPOINT ["node", "transcribe-videos.mjs"]
