POSTGRES_PASSWORD=change_me
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5688/

# ---- Cerebro del chat (contenedor web) ----
# auto  → local si hay claves + base; si no, proxy
# local → todo en el servidor (Postgres propio + Gemini + OpenRouter)
# proxy → reenvía a la Edge Function de Supabase (no requiere claves aquí)
CHAT_MODE=auto

# Necesarias solo para CHAT_MODE=local.
# El modelo de embeddings DEBE ser gemini-embedding-001 (3072 dims),
# porque así están vectorizados los datos en la base.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Necesarias solo para CHAT_MODE=proxy.
SUPABASE_CHAT_URL=https://roxbekpxdgvqbosepmdd.supabase.co/functions/v1/chatbot-iglesia-palabra-pura
SUPABASE_PUBLISHABLE_KEY=

# Supabase (cuenta Palabra Pura — referencia; nunca pongas secret keys en git)
# Project: roxbekpxdgvqbosepmdd
